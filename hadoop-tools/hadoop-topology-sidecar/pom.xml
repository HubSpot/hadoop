<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.hubspot.hadoop</groupId>
  <artifactId>hadoop-topology-sidecar</artifactId>
  <version>3.3.6-hubspot-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Apache Hadoop Topology Sidecar Client</name>
  <description>
    A DNSToSwitchMapping implementation that resolves rack topology by making
    HTTP calls to a co-located sidecar, replacing the forked topology script
    that was OOM-killing NameNodes. Installed on the NameNode (and later
    NodeManager) classpath and selected via
    net.topology.node.switch.mapping.impl.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <!-- The hadoop-common already on the NameNode classpath at runtime. -->
    <hadoop.version>3.3.6-hubspot-SNAPSHOT</hadoop.version>
  </properties>

  <dependencies>
    <!--
      All Hadoop (and its transitive) classes are already on the NameNode
      classpath at runtime, so hadoop-common is <provided>: compiled against,
      never bundled. This jar must ship with only its own two classes.
    -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>${hadoop.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
